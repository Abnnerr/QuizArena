generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  user_id       String @id @default(uuid())
  user_email    String @unique
  user_username String @unique
  user_password String
  role_id       Int

  Role        Role    @relation(fields: [role_id], references: [role_id])
  hostedRooms Rooms[]
}

model Players {
  player_id   String @id @default(uuid())
  player_name String @unique

  roomPlayers RoomPlayer[]
  answers     Answers[]
  powerupUses PowerupUse[]
}

model Role {
  role_id         Int              @id @default(autoincrement())
  role_name       Roles            @unique
  users           Users[]
  rolePermissions RolePermission[]
}

model Permissions {
  permission_id   Int             @id @default(autoincrement())
  permission_name PermissionseNum @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  role_id       Int
  permission_id Int

  role       Role        @relation(fields: [role_id], references: [role_id])
  permission Permissions @relation(fields: [permission_id], references: [permission_id])

  @@id([role_id, permission_id])
}

model Rooms {
  room_id      Int        @id @default(autoincrement())
  room_code    String     @unique
  room_name    String
  host_user_id String
  max_players  Int        @default(20)
  time_limit   Int        @default(20)
  room_mode    GameMode   @default(NORMAL)
  room_status  RoomStatus @default(LOBBY)
  position     Int        @default(0)

  host          Users          @relation(fields: [host_user_id], references: [user_id])
  roomPlayers   RoomPlayer[]
  roomQuestions RoomQuestion[]
  rounds        Round[]
  powerupUses   PowerupUse[]
}

model RoomPlayer {
  room_id   Int
  player_id String
  score     Int      @default(0)
  joined_at DateTime @default(now())
  ready     Boolean  @default(false)

  rooms   Rooms   @relation(fields: [room_id], references: [room_id])
  players Players @relation(fields: [player_id], references: [player_id])

  @@id([room_id, player_id])
}

model RoomQuestion {
  room_id     Int
  question_id Int
  position    Int

  rooms     Rooms     @relation(fields: [room_id], references: [room_id])
  questions Questions @relation(fields: [question_id], references: [question_id])

  @@id([room_id, question_id])
  @@unique([room_id, position])
}

model Questions {
  question_id   Int     @id @default(autoincrement())
  question_text String
  active        Boolean @default(true)

  alternatives  Alternatives[]
  roomQuestions RoomQuestion[]
  rounds        Round[]
}

model Alternatives {
  alternative_id   Int     @id @default(autoincrement())
  alternative_text String
  is_correct       Boolean
  question_id      Int

  question Questions @relation(fields: [question_id], references: [question_id])
  answers  Answers[]
}

model Round {
  round_id    Int       @id @default(autoincrement())
  room_id     Int
  question_id Int
  opened_at   DateTime  @default(now())
  closed_at   DateTime?

  rooms     Rooms     @relation(fields: [room_id], references: [room_id])
  questions Questions @relation(fields: [question_id], references: [question_id])
  answers   Answers[]
}

model Answers {
  answer_id      Int      @id @default(autoincrement())
  player_id      String
  round_id       Int
  alternative_id Int
  points         Int      @default(0)
  answered_at    DateTime @default(now())

  player      Players      @relation(fields: [player_id], references: [player_id])
  round       Round        @relation(fields: [round_id], references: [round_id])
  alternative Alternatives @relation(fields: [alternative_id], references: [alternative_id])

  @@unique([player_id, round_id])
}

model PowerupUse {
  powerup_use_id Int         @id @default(autoincrement())
  player_id      String
  room_id        Int
  powerup_type   PowerupType
  used_at        DateTime    @default(now())

  players Players @relation(fields: [player_id], references: [player_id])
  rooms   Rooms   @relation(fields: [room_id], references: [room_id])

  @@unique([player_id, room_id, powerup_type])
}

enum RoomStatus {
  LOBBY
  LIVE
  FINISHED
}

enum GameMode {
  NORMAL
  HARDCORE
}

enum PowerupType {
  FIFTY_FIFTY
}

enum Roles {
  user
  admin
  host
}

enum PermissionseNum {
  USER_READ
  USER_UPDATE
  USER_DELETE
  ROOM_CREATE
  ROOM_READ
  ROOM_UPDATE
  ROOM_DELETE
  ROOM_JOIN
  ROOM_LEAVE
  ROOM_START
  ROOM_FINISH
  QUESTION_CREATE
  QUESTION_READ
  QUESTION_UPDATE
  QUESTION_DELETE
  ALTERNATIVE_CREATE
  ALTERNATIVE_READ
  ALTERNATIVE_UPDATE
  ALTERNATIVE_DELETE
  ROUND_READ
  ROUND_START
  ROUND_FINISH
  ANSWER_CREATE
  ANSWER_READ
  POWERUP_USE
  POWERUP_READ
}
